{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodus",
  "version": "0.6.0",
  "identifier": "com.thekay.nodus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nodus",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#090806"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Local agent orchestration, composed with intent.",
    "longDescription": "Nodus is a local-first desktop surface for observing and orchestrating AI agents.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
